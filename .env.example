SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret
BRIDGE_ALLOWED_USER_ID=U0123456789
BRIDGE_ALLOWED_CHANNEL_IDS=C0123456789,D0123456789
BRIDGE_DEFAULT_CWD=/path/to/your/workspace
BRIDGE_CODEX_BIN=/opt/homebrew/bin/codex
BRIDGE_DATA_DIR=.bridge-data
BRIDGE_ENABLED_ON_START=false
BRIDGE_APPROVAL_POLICY=on-request
BRIDGE_USE_CAFFEINATE=false
