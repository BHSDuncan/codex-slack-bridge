{
  "name": "codex-slack-bridge",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "launchd:install": "scripts/install-launch-agent.sh",
    "launchd:uninstall": "scripts/uninstall-launch-agent.sh",
    "launchd:status": "scripts/launch-agent-status.sh"
  },
  "dependencies": {
    "@slack/bolt": "^3.21.4",
    "dotenv": "^16.4.7",
    "nanoid": "^5.0.9",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
